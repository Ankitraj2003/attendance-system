# Local development only; replace placeholders locally and never commit real secrets.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application settings
COMPANY_NAME=Expandit
COMPANY_TIMEZONE=Asia/Kolkata
STORAGE_DIR=storage/uploads
MAX_FILE_SIZE_MB=5
ALLOWED_ORIGINS=http://localhost:5173

# Production-only: create the first administrator if the configured username does not exist.
# Existing administrator passwords are never reset during app startup.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@expandit.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-strong-password
