# ==============================================================================
# Expandit Attendance System - Environment Variables Template
# ==============================================================================
# CRITICAL SECURITY NOTICE:
# 1. Never commit real credentials, database passwords, or secret keys to Git.
# 2. For local development, copy this file to .env and fill in local values.
# 3. For production (Render / Neon / Vercel), configure variables directly in the
#    respective hosting provider's dashboard.
# ==============================================================================

# Runtime Environment (development | production)
ENVIRONMENT=development

# Database Connection URI (Neon / PostgreSQL)
# Local: postgresql+psycopg://username:password@localhost:5432/attendance_dev
# Production: Set in Render service environment using pooled connection string.
DATABASE_URL=postgresql+psycopg://PLACEHOLDER_USER:PLACEHOLDER_PASSWORD@PLACEHOLDER_HOST/PLACEHOLDER_DB?sslmode=require

# JWT Cryptographic Signing Key (Minimum 32 random characters in production)
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# JWT Parameters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Tenant and Regional Settings
COMPANY_NAME=Expandit
COMPANY_TIMEZONE=Asia/Kolkata

# Local Storage (Render ephemeral or persistent disk)
STORAGE_DIR=storage/uploads
MAX_FILE_SIZE_MB=5

# CORS Allowed Origins (Comma-separated exact URLs, no wildcards with credentials)
# Example: https://hrms-frontend.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Production Administrator Bootstrap (Applied only once if admin is absent)
# Never use default or predictable passwords. Must be >= 9 chars, letter, digit, special character.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Optional: Development-only bootstrap password override
DEV_ADMIN_PASSWORD=LocalDevAdmin@2026!
