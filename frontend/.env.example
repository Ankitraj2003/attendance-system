# ==============================================================================
# Frontend Environment Configuration (Vite)
# ==============================================================================
# SECURITY NOTICE:
# Any variable starting with VITE_ is statically embedded into the compiled
# client-side JavaScript bundle and is VISIBLE TO ANY USER in their browser.
# NEVER place database credentials, JWT secrets, or administrative tokens here.
# ==============================================================================

# Public API URL endpoint (Points to deployed Render backend API)
VITE_API_BASE_URL=https://your-render-service.onrender.com/api
